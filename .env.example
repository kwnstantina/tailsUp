# TailsUp — environment variable template.
#
# HOW TO USE: copy this file to `.env` (`cp .env.example .env`) and fill in
# real values. `.env` is git-ignored; ONLY this `.env.example` (placeholders,
# no real secrets) is committed (NFR-5, AC-8).
#
# WHERE EACH VAR IS NEEDED:
#   - "API (local)"   read by apps/api at runtime from the root .env / process env.
#   - "CI (Secrets)"  set as GitHub Actions Secrets for the daily backup workflow
#                     (.github/workflows/db-backup.yml). NOT loaded from this file
#                     in CI — configure them under repo Settings -> Secrets.
#   - "Mobile"        read by apps/mobile (Expo) — see the EXPO_PUBLIC note below.
#
# Phase 1 NOTE: only DATABASE_URL is actually read by Phase 1 code. The other
# API vars below are templated for later phases (AI / Auth / Email / media R2)
# so the full secret surface is documented from day one — no Phase 1 code reads
# them, so leaving placeholders here does not break startup.

# ============================================================================
# DB — PostgreSQL (API local + CI Secret)
# ============================================================================
# Postgres connection string. Required by apps/api (db client, migrations) and
# by the daily backup workflow (as a GitHub Secret of the same name).
DATABASE_URL=postgresql://user:password@localhost:5432/tailsup

# ============================================================================
# AI — Anthropic (API local; Phase 4 only — not read in Phase 1)
# ============================================================================
# Anthropic API key for cheap progress summaries (claude-haiku-4-5) in Phase 4.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# R2 — Cloudflare object storage (API local + CI Secret)
# ============================================================================
# Cloudflare account id. Forms the R2 S3 endpoint:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Used by the backup workflow (CI Secret) and by media presign in Phase 2.
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 API token credentials. The token used by the backup workflow MUST be
# scoped "Object Read & Write" (a Read-Only token fails the upload).
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Media bucket (Phase 2 presigned uploads). Distinct from the backups bucket.
R2_BUCKET=tailsup-media

# ============================================================================
# Auth — BetterAuth (API local; Phase 3b — REQUIRED once auth lands)
# ============================================================================
# Secret used to sign auth sessions/tokens. REQUIRED in Phase 3b: config.ts
# throws on startup if unset (no silent default — NFR-3). Generate with e.g.
# `openssl rand -base64 32`. Never commit a real value.
AUTH_SECRET=generate_a_long_random_string
# Auth baseURL BetterAuth uses to build its /api/auth/* endpoint URLs. Optional:
# defaults to http://localhost:<PORT> for dev. Set to the public API origin in
# any non-localhost deploy (e.g. https://api.tailsup.example).
# BETTER_AUTH_URL=http://localhost:3000
# CORS origin allow-list (comma-separated), credentialed — replaces the Phase 3a
# allow-all CORS so cookie auth works cross-origin. Optional: defaults to the
# Expo web dev origins (http://localhost:8081, http://localhost:19006) + the API
# origin. Set to your real web origin(s) in production.
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ============================================================================
# Email — Resend (API local; Phase 3 only — not read in Phase 1)
# ============================================================================
# Resend API key for lead/booking emails in Phase 3 (stubbed when absent).
# Read LAZILY in apps/api/src/lib/email.ts — NOT in config.ts. When unset/blank
# the lead-notification email is a logged no-op stub (never blocks the 201).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional — the "from" address for lead-notification emails. Production needs a
# Resend-verified domain; defaults to onboarding@resend.dev for dev when unset.
# RESEND_FROM=TailsUp <onboarding@resend.dev>

# ============================================================================
# Practice — single-practice trainer for PUBLIC writes (API local; Phase 3a)
# ============================================================================
# Optional. The public capture endpoints (POST /leads, POST /bookings) have no
# auth and no trainer in context, but lead/booking.trainerId is a NOT-NULL FK.
# resolveTrainerId() (apps/api/src/lib/trainer.ts) reads this LAZILY: if set it
# pins the practice trainer; if unset it defaults to the single seeded trainer
# (sole/oldest trainer row). With no trainer at all the endpoints return 503.
# Kept OUT of config.ts (intentionally optional).
# PRACTICE_TRAINER_ID=00000000-0000-0000-0000-000000000000

# ----------------------------------------------------------------------------
# NON-API vars used ELSEWHERE (NOT part of the API's required set above)
# ----------------------------------------------------------------------------

# Mobile (apps/mobile) — Expo client. The Expo app reads its API base URL from
# EXPO_PUBLIC_API_URL. In practice this lives in apps/mobile/.env (also
# git-ignored), but it is documented here for completeness. Dev networking:
#   web / iOS simulator      -> http://localhost:3000
#   Android emulator         -> http://10.0.2.2:3000
#   physical device (Expo Go)-> http://<your-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# CI only (GitHub Secret) — SEPARATE Cloudflare R2 bucket for database dumps,
# distinct from the media bucket R2_BUCKET. Used solely by the daily backup
# workflow. Not read by the API.
R2_BACKUP_BUCKET=tailsup-db-backups

# Optional — API HTTP port. apps/api defaults to 3000 when unset; the only
# intentionally-optional variable.
# PORT=3000
