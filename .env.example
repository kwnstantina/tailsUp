# TailsUp — environment variable template.
#
# HOW TO USE: copy this file to `.env` (`cp .env.example .env`) and fill in
# real values. `.env` is git-ignored; ONLY this `.env.example` (placeholders,
# no real secrets) is committed (NFR-5, AC-8).
#
# WHERE EACH VAR IS NEEDED:
#   - "API"           read by apps/api at runtime from the root .env / process env.
#                     In production these are set in the Railway service variables,
#                     NOT from a file.
#   - "CI (Secrets)"  set as GitHub Actions Secrets for the daily backup workflow
#                     (.github/workflows/db-backup.yml). NOT loaded from this file
#                     in CI — configure them under repo Settings -> Secrets.
#   - "Mobile"        read by apps/mobile (Expo) — see apps/mobile/.env.example.
#
# REQUIRED SET — the API THROWS at startup if either is missing (D-11, NFR-3):
#   DATABASE_URL, AUTH_SECRET
# Everything else is optional with a documented default, BUT several of the
# optional ones MUST be set explicitly in production (marked "SET IN PROD" below)
# because their defaults are localhost dev conveniences that fail silently —
# a wrong ALLOWED_ORIGINS does not crash the API, it just makes every browser
# request from the real site fail CORS.

# ============================================================================
# DB — PostgreSQL (API + CI Secret)  [REQUIRED]
# ============================================================================
# Postgres connection string. Required by apps/api (db client, migrations) and
# by the daily backup workflow (as a GitHub Secret of the same name).
#   local      -> postgresql://postgres:postgres@localhost:5432/tailsup
#   production -> Railway's connection string. Use the PRIVATE string for the
#                 API service (same-project networking, no egress cost) and the
#                 PUBLIC string for the GitHub Actions backup (runners are
#                 external + IPv4-only).
DATABASE_URL=postgresql://user:password@localhost:5432/tailsup

# ============================================================================
# Auth — BetterAuth (API)  [AUTH_SECRET REQUIRED]
# ============================================================================
# Secret used to sign auth sessions/tokens. REQUIRED: config.ts throws on
# startup if unset (no silent default — NFR-3). Generate with:
#   openssl rand -base64 32
# Never commit a real value. Rotating it invalidates every live session.
AUTH_SECRET=generate_a_long_random_string

# Auth baseURL BetterAuth uses to build its /api/auth/* endpoint URLs, and the
# origin the session cookie is issued for. Optional: defaults to
# http://localhost:<PORT>. SET IN PROD — a wrong value breaks sign-in.
#   production -> https://api.tailsupacademy.gr
# BETTER_AUTH_URL=http://localhost:3000

# CORS origin allow-list (comma-separated), credentialed. Also seeds BetterAuth's
# trustedOrigins (CSRF allow-list) in lib/auth.ts. Never '*' — auth uses cookies,
# and a credentialed CORS response may not use a wildcard.
# Optional: defaults to the Expo web dev origins (http://localhost:8081,
# http://localhost:19006) + the API's own origin. SET IN PROD.
#   production -> https://tailsupacademy.gr,https://www.tailsupacademy.gr
#
# NOTE on the cookie: the site (tailsupacademy.gr) and the API (api.tailsupacademy.gr) share a
# registrable domain, so the default SameSite=Lax session cookie is sent on the
# site's cross-ORIGIN (but same-SITE) fetches. If the API is ever moved to a
# DIFFERENT registrable domain (e.g. *.up.railway.app), web login breaks until
# lib/auth.ts sets advanced.defaultCookieAttributes = { sameSite:'none', secure:true }.
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ============================================================================
# Practice identity — single-practice trainer for PUBLIC writes (API)
# ============================================================================
# Optional. The public capture endpoints (POST /leads, POST /bookings) have no
# auth and no trainer in context, but lead/booking.trainerId is a NOT-NULL FK —
# so the owning trainer is resolved from config, never from the request body
# (a body-supplied trainerId would be forgeable).
#
# resolveTrainerId() (apps/api/src/lib/trainer.ts) reads this LAZILY: if set it
# pins the practice trainer; if unset it falls back to the single seeded trainer
# (sole/oldest trainer row). With no trainer at all the endpoints return
#   503 { "error": "practice not configured" }
# rather than fabricating an id.
#
# Find the id once the practice trainer row exists:
#   psql "$DATABASE_URL" -c "select id, name from trainer;"
# Kept OUT of config.ts (intentionally optional).
# PRACTICE_TRAINER_ID=00000000-0000-0000-0000-000000000000

# ============================================================================
# R2 — Cloudflare object storage (API + CI Secret)
# ============================================================================
# Read LAZILY in apps/api/src/lib/r2.ts (getR2Config()), never at startup — the
# API boots and the whole test suite runs without them. A media presign with any
# of them missing returns 503 rather than a fabricated URL (NFR-4).
#
# Cloudflare account id. Forms the R2 S3 endpoint:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 API token credentials. The token used by the backup workflow MUST be
# scoped "Object Read & Write" (a Read-Only token fails the upload).
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Media bucket (presigned video uploads). Distinct from the backups bucket.
#
# BUCKET CORS: the browser PUTs directly to R2 from the site origin, so the
# media bucket needs a CORS rule allowing PUT from that origin. This is a
# CLOUDFLARE DASHBOARD SETTING, NOT API CODE:
#   AllowedOrigins: https://tailsupacademy.gr  (+ http://localhost:8081 for dev)
#   AllowedMethods: PUT, GET
#   AllowedHeaders: content-type
R2_BUCKET=tailsup-media

# ============================================================================
# Email — Resend (API)
# ============================================================================
# Resend API key for lead-notification emails. Read LAZILY in
# apps/api/src/lib/email.ts — NOT in config.ts. When unset/blank the email is a
# logged no-op stub and NEVER blocks the 201 on POST /leads.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional — the "from" address. Defaults to onboarding@resend.dev, which only
# delivers to the Resend account owner. SET IN PROD with a Resend-VERIFIED
# domain or real lead notifications will not arrive.
#   production -> TailsUp <leads@tailsupacademy.gr>
# RESEND_FROM=TailsUp <onboarding@resend.dev>

# ============================================================================
# AI — Anthropic (API; Phase 4 — NOT read by any code yet)
# ============================================================================
# Anthropic API key for cheap progress summaries (claude-haiku-4-5) in Phase 4.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# NON-API vars used ELSEWHERE (NOT part of the API's variable set above)
# ----------------------------------------------------------------------------

# Mobile (apps/mobile) — Expo client. See apps/mobile/.env.example for the full
# dev-networking matrix. Anything prefixed EXPO_PUBLIC_ is inlined into the
# client bundle at build time and is therefore PUBLIC — never put secrets there.
#   production web build -> https://api.tailsupacademy.gr
EXPO_PUBLIC_API_URL=http://localhost:3000

# CI only (GitHub Secret) — SEPARATE Cloudflare R2 bucket for database dumps,
# distinct from the media bucket R2_BUCKET. Used solely by the daily backup
# workflow. Not read by the API.
R2_BACKUP_BUCKET=tailsup-db-backups

# Optional — API HTTP port. apps/api defaults to 3000 when unset. Railway
# injects its own PORT; do not hardcode it there.
# PORT=3000

# ----------------------------------------------------------------------------
# SEEDING — read this before touching a production database
# ----------------------------------------------------------------------------
# `npm run db:seed -w apps/api` is a LOCAL DEMO seed. It creates the demo
# practice graph plus two BetterAuth logins with HARDCODED, PUBLICLY-KNOWN
# passwords (see apps/api/src/seed.ts):
#     trainer@tailsup.local / Trainer123!
#     client@tailsup.local  / Client123!
# It reads NO environment variables for those accounts.
#
#   *** NEVER RUN db:seed AGAINST PRODUCTION. ***
#
# It would create working logins whose credentials are committed to this repo.
# In production, create the first trainer login out-of-band instead (a one-off
# script using auth.api.signUpEmail with a generated password, then patch
# user.role='trainer' + user.trainerId to the real trainer row).
