{
  "name": "tailsup",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build:web -w apps/mobile",
    "deploy:web": "npm run build:web && npx wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
