# apps/mobile/.env.example  (mobile-local — copy to apps/mobile/.env, which is git-ignored)
#
# The Expo app reads the API base URL from EXPO_PUBLIC_API_URL.
# Anything prefixed EXPO_PUBLIC_ is inlined into the client bundle at build time
# and is therefore PUBLIC — never put secrets here. Access it only via static
# dot-notation in code (process.env.EXPO_PUBLIC_API_URL) so Expo can inline it.
EXPO_PUBLIC_API_URL=http://localhost:3000

# The seeded trainer id the Phase 2 trainer view scopes reads to (G-1 — pre-auth
# trainer context). Reads are path-scoped: GET /trainers/:trainerId/dogs. In
# Phase 3 this is replaced by the authenticated trainer id (drop this var). Read
# via static dot-access only (process.env.EXPO_PUBLIC_TRAINER_ID) so Expo inlines it.
EXPO_PUBLIC_TRAINER_ID=00000000-0000-0000-0000-000000000000

# --- Dev networking matrix -------------------------------------------------
# The correct host depends on WHERE the app runs (the #1 "it doesn't connect"
# gotcha). Set EXPO_PUBLIC_API_URL accordingly:
#
#   Where the app runs              | EXPO_PUBLIC_API_URL
#   --------------------------------+--------------------------------------
#   Expo web (browser, dev machine) | http://localhost:3000
#   iOS simulator                   | http://localhost:3000
#   Android emulator                | http://10.0.2.2:3000   (emulator alias for host loopback)
#   Physical device (Expo Go)       | http://<your-LAN-IP>:3000   (e.g. http://192.168.1.42:3000;
#                                   |   device + dev machine on the same Wi-Fi)
#
# Phase 1 acceptance (AC-9) only requires the WEB target, so the localhost
# default above is sufficient for verification.
